+jobs:
+  build-frontend:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Use Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '18'
+      - name: Install pnpm
+        run: npm install -g pnpm
+      - name: Install frontend deps
+        run: |
+          cd frontend || exit 0
+          pnpm install
+      - name: Build frontend
+        run: |
+          cd frontend || exit 0
+          pnpm run build || echo "No build script found"
+
+  build-api:
+    runs-on: ubuntu-latest
+    needs: build-frontend
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build API (Docker)
+        run: |
+          if [ -f api/Dockerfile ]; then
+            docker build -t openverse-api ./api
+          else
+            echo "No api/Dockerfile found — skipping docker build"
+          fi
+
